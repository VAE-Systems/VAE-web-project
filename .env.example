# VAE Website — Environment Variables
# Kopieren nach .env (wird NICHT committed, steht in .gitignore)

# ── Directus CMS ──────────────────────────────────────────────────────────────
# URL der Directus-Instanz auf Hetzner
VITE_DIRECTUS_URL=https://cms.vae-systems.com

# Public Read-Only Token (in Directus unter Settings → API Tokens erstellen)
# Nur Lese-Rechte für published content nötig
VITE_DIRECTUS_TOKEN=

# ── Sonstiges ─────────────────────────────────────────────────────────────────
# Wird später für Analytics, Booking-Links etc. genutzt
# VITE_BOOKING_URL=https://cal.vae-systems.com
