{
  "name": "vae-website-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VAE Systems - Professional Website Rebuild with Modern Tech Stack",
  "scripts": {
    "dev": "vite",
    "build": "tsc && node scripts/build-assets.js && vite build",
    "build:ssg": "npm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "analyze": "ANALYZE=true npm run build",
    "build-manifest": "node scripts/build-assets.js",
    "crawl": "node scripts/crawl-to-desktop.js --url=local",
    "crawl:prod": "node scripts/crawl-to-desktop.js --url=https://vae.systems",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/gsap": "^1.20.2",
    "@types/three": "^0.178.1",
    "framer-motion": "^10.18.0",
    "glob": "^10.5.0",
    "gsap": "^3.13.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.536.0",
    "ogl": "^1.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "three": "^0.179.1",
    "typewriter-effect": "^2.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@prerenderer/rollup-plugin": "^0.3.12",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-viewport": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@types/node": "^24.1.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.6",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^15.5.2",
    "node-fetch": "^3.3.2",
    "postcss": "^8.4.38",
    "prerender-spa-plugin": "^3.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "puppeteer": "^24.34.0",
    "react-snap": "^1.23.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.34.5",
    "storybook": "^8.2.9",
    "tailwindcss": "^3.4.4",
    "terser": "^5.44.0",
    "typescript": "^5.2.2",
    "vite": "^6.4.1",
    "vite-bundle-analyzer": "^0.7.0"
  },
  "keywords": [
    "vae-systems",
    "react",
    "typescript",
    "tailwind",
    "gsap",
    "modern-website"
  ],
  "author": "VAE Systems",
  "license": "MIT",
  "react-snap": {
    "include": [
      "/",
      "/services/setup",
      "/services/betreuung",
      "/services/beratung",
      "/leistungen/strategie",
      "/leistungen/infrastruktur",
      "/leistungen/betreuung",
      "/ressourcen/faq",
      "/ressourcen/blog",
      "/ressourcen/case-studies",
      "/about/referenzen",
      "/case-studies",
      "/ueber-uns/werte",
      "/ueber-uns/design-handwerk",
      "/ueber-uns/leitung",
      "/ueber-uns/team",
      "/wissen/transparenz-open-source",
      "/wissen/klare-projektkommunikation",
      "/wissen/vendor-lock-in-vermeiden",
      "/wissen/handwerkskunst-statt-schnellschuss",
      "/wissen/skalierbare-architektur",
      "/contact",
      "/impressum",
      "/privacy",
      "/privacy/settings"
    ],
    "http2PushManifest": true,
    "inlineCss": true,
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    }
  }
}
